# Copy to .env.local for local dev. On Railway, set these in Variables.
# All keys are optional — without them the app runs in Demo mode.

# —— Live Cala graph (reports, market, company cards) ——
CALA_API_KEY=
# CALA_API_BASE=https://api.cala.ai
# CALA_RPM=9
# CALA_TIMEOUT_MS=180000
# CALA_MAX_CONCURRENCY=6
# CALA_GRAPH_CONCURRENCY=3
# CALA_429_BACKOFF_MS=20000

# —— AI Scout / Ask (optional) ——
ANTHROPIC_API_KEY=

# —— Auth + cloud profiles + Express interest sync (optional) ——
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# —— Defaults / cache (optional) ——
# KYI_DATA_MODE=cala
# KYI_CACHE_DIR=.kyi-cache
# KYI_CACHE_TTL_HOURS=72
# KYI_MAX_PORTFOLIO=6
# KYI_MAX_ENRICH=10
# KYI_MAX_ROUND_DETAILS=15

# Railway sets PORT automatically — do not set it yourself.
